# Port for the Express backend server
PORT=5000

# PostgreSQL Connection Details (Standard format: postgresql://username:password@host:port/database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_dashboard

# Secret used to sign express-session cookies (Choose a long random string)
SESSION_SECRET=super_secret_discord_dashboard_session_key_123456

# Discord Developer Portal Credentials
# Create an application at https://discord.com/developers/applications
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET

# Use either BOT token or USER token (selfbot). USER token takes priority if both are set.
# For selfbot mode, set DISCORD_USER_TOKEN to your user account token.
# For standard bot mode, set DISCORD_BOT_TOKEN.
# WARNING: User accounts may violate Discord Terms of Service.
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
# DISCORD_USER_TOKEN=YOUR_DISCORD_USER_TOKEN

# The OAuth2 Redirect URI configured in the Discord Developer Portal under OAuth2 > Redirects
DISCORD_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Frontend URL (For CORS policies and post-login redirection)
FRONTEND_URL=http://localhost:5173
